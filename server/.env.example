# XPoke server. Copy to .env and fill in. ⛔ .env holds the pool wallet key: never commit it.

# ------------------------------------------------------------ site
PORT=5340
PUBLIC_URL=https://xpoke.example          # real public origin, no trailing slash (used in replies + X login)
DATA_DIR=./data
WEB_DIST=../web/dist
ADMIN_TOKEN=                               # long random string, for POST /api/admin/tournament (x-admin-token header)
DEV_MODE=0                                 # 1 = /dev console + dev login. NEVER on in production.

# ------------------------------------------------------------ X
X_HANDLE=xpokefun                          # the account people mention, no @
X_SOURCE=twitterapi.io                     # twitterapi.io | x-api | fixture
X_REPLY=twitterapi.io                      # twitterapi.io | x-api | none
TWITTERAPI_IO_KEY=                         # ⚠ its own key: never share one balance with another project's poller
TWITTERAPI_IO_LOGIN_COOKIE=                # from /twitter/user_login_v2 for the bot account (a password)
TWITTERAPI_IO_PROXY=
X_BEARER_TOKEN=                            # only for x-api (user-context token to post)
X_USER_ID=
POLL_SECONDS=20                            # while people are playing; polls only ask for mentions newer than the last seen
POLL_IDLE_SECONDS=90                       # after 10 quiet minutes
CATCHUP_MINUTES=45                         # wide 2 h re-read (the mentions index can lag over an hour)
DRY_RUN=0                                  # 1 = replies kept in memory, nothing posted

# "Login with X" on the site: an X developer app, callback exactly <PUBLIC_URL>/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# ------------------------------------------------------------ the model (free-text commands + chat)
LLM_ENABLED=1
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=                         # Anthropic direct
ANTHROPIC_AUTH_TOKEN=                      # OR a Bearer-token gateway key (e.g. OpenRouter)
ANTHROPIC_BASE_URL=                        # e.g. https://openrouter.ai/api with LLM_MODEL=anthropic/claude-opus-5.5
LLM_PER_USER_HOUR=5                        # model calls per trainer per hour (rules still work past it)
LLM_DAILY_CAP=300                          # hard ceiling on model calls per UTC day

# ------------------------------------------------------------ Solana
TOKEN_MINT=                                # $XPOKE SPL mint (Token or Token-2022). Empty = shop and wagers stay closed.
TOKEN_SYMBOL=XPOKE
TOKEN_DECIMALS=6                           # pump.fun mints have 6
POOL_SECRET=                               # 🔴 pool wallet secret (base58 or JSON array): receives payments, sends payouts/refunds/burns.
                                           #    Keep ~0.05 SOL in it for fees and recipients' token-account rent.
POOL_ADDRESS=                              # watch-only alternative when no secret is set
PAYOUTS_ENABLED=0                          # 1 = actually send payouts, refunds and burns
SOLANA_RPC=                                # a keyed RPC (Helius etc.) of XPoke's own; ⛔ publicnode refuses getSignaturesForAddress
RPC_RPS=4                                  # requests per second, paced (providers limit bursts)
PRIORITY_MICROLAMPORTS=50000               # priority fee on payouts
